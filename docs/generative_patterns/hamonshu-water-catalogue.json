        ]
      }
    },
    {
      "id": "crest",
      "name": "Crests and breakers",
      "description": "Overturning hooks, curling tips, upright breaking waves and layered wave fronts.",
      "construction": "Parametric crest paths with a return curl; nested contours and optional foam.",
      "representative": {
        "volume": 3,
        "scan": 22,
        "box": [
          0.52,
          0.22,
          0.9,
          0.9
        ]
      }
    },
    {
      "id": "eddy",
      "name": "Eddies, scrolls and spirals",
      "description": "Coiled currents, opposing scrolls, whirlpools and spiral medallions.",
      "construction": "Spiral segments joined to flow paths; paired handedness and unequal curl radii.",
