{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://izzi.dev/schemas/izzi-visual-review.schema.json",
  "title": "Izzi current visual and audio review configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "status",
    "entries",
    "overview_panels",
    "authority"
  ],
  "properties": {
    "schema_version": {
      "const": "izzi-visual-review-1"
    },
    "review_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "status": {
      "const": "CANDIDATE-NOT-PROMOTED"
    },
    "entries": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "overview_panels": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "path"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "path": {
            "type": "string",
            "pattern": "^outputs/[A-Za-z0-9._/-]+\\.png$"
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_generation_authorized",
        "human_acceptance",
        "baseline_promotion_authorized",
        "publication_authorized",
        "external_transfer_authorized"
      ],
      "properties": {
        "local_generation_authorized": { "const": true },
        "human_acceptance": { "const": "PENDING" },
        "baseline_promotion_authorized": { "const": false },
        "publication_authorized": { "const": false },
        "external_transfer_authorized": { "const": false }
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "category",
        "subject",
        "feedback_round",
        "source_path",
        "manifest_path",
        "current_path",
        "artifact_contract",
        "feedback_contract",
        "human_review_state"
      ],
      "properties": {
        "entry_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]+$"
        },
        "category": {
          "enum": [
            "static",
            "title-card-transitions",
            "wild-motion",
            "3d-synthesis",
            "4d-synthesis",
            "audio"
          ]
        },
        "subject": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]+$"
        },
        "feedback_round": {
          "type": "string",
          "pattern": "^round-[0-9]{2}$"
        },
        "source_path": {
          "type": "string",
          "pattern": "^outputs/[A-Za-z0-9._/-]+$"
        },
        "manifest_path": {
          "type": "string",
          "pattern": "^outputs/[A-Za-z0-9._/-]+\\.json$"
        },
        "current_path": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9./-]+$"
        },
        "artifact_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["glob", "count", "media_kind"],
          "properties": {
            "glob": { "type": "string", "minLength": 1 },
            "count": { "type": "integer", "minimum": 1 },
            "media_kind": {
              "enum": ["SVG", "PNG", "MKV", "WAV"]
            }
          }
        },
        "feedback_contract": {
          "type": "object",
          "minProperties": 1
        },
        "human_review_state": {
          "const": "PENDING"
        }
      }
    }
  }
}
