{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://izzi.dev/schemas/izzi.lenticular-array-1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "izzi.lenticular-array/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width_mm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        },
        "height_mm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        }
      },
      "required": [
        "width_mm",
        "height_mm"
      ]
    },
    "lenses_per_inch": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000
    },
    "axis": {
      "enum": [
        "vertical",
        "horizontal"
      ]
    },
    "phase_mm": {
      "type": "number"
    },
    "view_order": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 7
      }
    },
    "crop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "raster_ppi": {
      "type": "number",
      "minimum": 0,
      "maximum": 65536
    },
    "integer_grid": {
      "type": "boolean"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maximum_paths": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_points": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_svg_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": []
    },
    "views": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "$ref": "izzi.guilloche-scene-1.schema.json"
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "output",
    "lenses_per_inch",
    "axis",
    "views"
  ]
}
