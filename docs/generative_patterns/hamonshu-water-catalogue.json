  "groups": [
    {
      "id": "flow",
      "name": "Currents and waterlines",
      "description": "Long meanders, flowing parallel lines, drifting pools and gently layered swells.",
      "construction": "Shared-displacement bands; cubic or harmonic centerlines; related contour families.",
