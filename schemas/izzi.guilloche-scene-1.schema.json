{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://izzi.example/schemas/izzi.guilloche-scene-1.schema.json",
  "title": "Izzi guilloche scene authoring document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scene_id",
    "canvas",
    "content",
    "treatment",
    "layout",
    "review"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "izzi.guilloche-scene/1" },
    "scene_id": { "$ref": "#/$defs/id" },
    "canvas": { "$ref": "#/$defs/canvas" },
    "content": { "$ref": "#/$defs/content" },
    "treatment": { "$ref": "#/$defs/treatment" },
    "layout": { "$ref": "#/$defs/radial_layout" },
    "palette": { "$ref": "#/$defs/palette" },
    "budget": { "$ref": "#/$defs/budget" },
    "review": { "$ref": "#/$defs/review" },
    "extensions": { "$ref": "#/$defs/extensions" },
    "pattern": { "$ref": "#/$defs/pattern" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "background"],
      "properties": {
        "width": { "type": "integer", "minimum": 64, "maximum": 16384 },
        "height": { "type": "integer", "minimum": 64, "maximum": 16384 },
        "background": { "$ref": "#/$defs/color" }
      }
    },
    "number_content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "number", "accessible_label"],
      "properties": {
        "kind": { "const": "number" },
        "number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9][0-9 .,+-]*$"
        },
        "accessible_label": { "$ref": "#/$defs/text" }
      }
    },
    "word_content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "word", "accessible_label"],
      "properties": {
        "kind": { "const": "word" },
        "word": { "$ref": "#/$defs/text" },
        "accessible_label": { "$ref": "#/$defs/text" }
      }
    },
    "word_number_content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "word", "number", "accessible_label"],
      "properties": {
        "kind": { "const": "word-number" },
        "word": { "$ref": "#/$defs/text" },
        "number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9][0-9 .,+-]*$"
        },
        "accessible_label": { "$ref": "#/$defs/text" }
      }
    },
    "content": {
      "oneOf": [
        { "$ref": "#/$defs/number_content" },
        { "$ref": "#/$defs/word_content" },
        { "$ref": "#/$defs/word_number_content" }
      ]
    },
    "bounded_pair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "type": "integer", "minimum": 1, "maximum": 64 },
        { "type": "integer", "minimum": 1, "maximum": 64 }
      ],
      "items": false
    },
    "treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "seed",
        "floral_group_range",
        "petal_range",
        "cycloid_amplitude",
        "density"
      ],
      "properties": {
        "kind": {
          "enum": ["cycloid-outline", "floral-cells", "floral-cycloid"]
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "floral_group_range": { "$ref": "#/$defs/bounded_pair" },
        "petal_range": { "$ref": "#/$defs/bounded_pair" },
        "cycloid_amplitude": {
          "type": "number",
          "minimum": 0,
          "maximum": 256
        },
        "density": {
          "enum": ["accessible", "standard", "experimental", "wild"]
        }
      }
    },
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "type": "number", "minimum": 0, "maximum": 16384 },
        { "type": "number", "minimum": 0, "maximum": 16384 }
      ],
      "items": false
    },
    "radial_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "symmetry_order", "center", "radius"],
      "properties": {
        "kind": { "const": "radial" },
        "symmetry_order": {
          "type": "integer",
          "minimum": 2,
          "maximum": 24
        },
        "center": { "$ref": "#/$defs/point" },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 8192
        },
        "geometries": { "$ref": "#/$defs/geometries" }
      }
    },
    "harmonic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["multiple", "gain"],
      "properties": {
        "multiple": { "type": "integer", "minimum": 1, "maximum": 128 },
        "gain": { "type": "number", "minimum": -8, "maximum": 8 }
      }
    },
    "geometries": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/sunburst" },
          { "$ref": "#/$defs/band_guilloche" },
          { "$ref": "#/$defs/latent_image" },
          { "$ref": "#/$defs/fish_scale_field" },
          { "$ref": "#/$defs/barleycorn_field" },
          { "$ref": "#/$defs/medallion" },
          { "$ref": "#/$defs/vignette" },
          { "$ref": "#/$defs/multicolor_line" },
          { "$ref": "#/$defs/flinque" }
        ]
      }
    },
    "sunburst": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "sunburst" },
        "origin": { "$ref": "#/$defs/point" },
        "plate_index": { "type": "integer", "minimum": 0, "maximum": 7, "default": 0 },
        "outer_radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 8192 },
        "rays": { "type": "integer", "minimum": 1, "maximum": 20000, "default": 120 },
        "ray_tiers": { "type": "integer", "minimum": 1, "maximum": 256, "default": 2 },
        "inner_radius_fraction": { "type": "number", "minimum": 0, "exclusiveMaximum": 1, "default": 0.18 },
        "phase": { "type": "number", "default": 0 },
        "scale_step": { "type": "number", "default": 0.035 },
        "samples": { "type": "integer", "minimum": 2, "maximum": 4096, "default": 2 }
      }
    },
    "band_guilloche": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "band_guilloche" },
        "origin": { "$ref": "#/$defs/point" },
        "plate_index": { "type": "integer", "minimum": 0, "maximum": 7, "default": 0 },
        "span": { "type": "number", "exclusiveMinimum": 0, "maximum": 16384 },
        "amplitude": { "type": "number", "minimum": 0, "maximum": 8192 },
        "fundamental_frequency": { "type": "number", "exclusiveMinimum": 0, "maximum": 1024, "default": 12 },
        "harmonics": {
          "type": "array",
          "maxItems": 32,
          "default": [{ "multiple": 2, "gain": 0.28 }, { "multiple": 3, "gain": 0.12 }],
          "items": { "$ref": "#/$defs/harmonic" }
        },
        "phase": { "type": "number", "default": 0 },
        "line_count": { "type": "integer", "minimum": 1, "maximum": 20000, "default": 11 },
        "phase_step": { "type": "number", "default": 0.16 },
        "normal_offset_ratio": { "type": "number", "minimum": 0, "maximum": 32, "default": 0.2 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 20000, "default": 5 },
        "row_spacing": { "type": "number", "minimum": 0, "maximum": 16384, "default": 0 },
        "samples": { "type": "integer", "minimum": 8, "maximum": 16384, "default": 384 }
      }
    },
    "latent_image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "latent_image" },
        "origin": { "$ref": "#/$defs/point" },
        "plate_index": { "type": "integer", "minimum": 0, "maximum": 7, "default": 0 },
        "span": { "type": "number", "exclusiveMinimum": 0, "maximum": 16384 },
        "line_spacing": { "type": "number", "minimum": 0.25, "maximum": 1024, "default": 6 },
        "cell_size": { "type": "number", "minimum": 1, "maximum": 8192, "default": 72 },
        "primary_angle": { "type": "number", "minimum": -1.0471975511965976, "maximum": 1.0471975511965976, "default": -0.2 },
        "secondary_angle": { "type": "number", "minimum": -1.0471975511965976, "maximum": 1.0471975511965976, "default": 0.2 },
        "phase": { "type": "number", "minimum": -1.0471975511965976, "maximum": 1.0471975511965976, "default": 0 },
        "samples": { "type": "integer", "minimum": 2, "maximum": 4096, "default": 8 }
      }
    },
    "fish_scale_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "fish_scale_field" },
        "origin": { "$ref": "#/$defs/point" },
        "plate_index": { "type": "integer", "minimum": 0, "maximum": 7, "default": 0 },
        "cell_size": { "type": "number", "exclusiveMinimum": 0, "maximum": 8192 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 512, "default": 36 },
        "columns": { "type": "integer", "minimum": 1, "maximum": 512, "default": 28 },
        "scale_width": { "type": "number", "exclusiveMinimum": 0, "default": 1 },
        "scale_height": { "type": "number", "exclusiveMinimum": 0, "default": 0.72 },
        "overlap": { "type": "number", "minimum": 0, "exclusiveMaximum": 1, "default": 0.44 },
        "stagger": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
        "seam_depth": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.12 },
        "phase": { "type": "number", "default": 0 },
        "samples": { "type": "integer", "minimum": 2, "maximum": 4096, "default": 48 }
      }
    },
    "barleycorn_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "barleycorn_field" },
        "origin": { "$ref": "#/$defs/point" },
        "plate_index": { "type": "integer", "minimum": 0, "maximum": 7, "default": 0 },
        "cell_size": { "type": "number", "exclusiveMinimum": 0, "maximum": 8192 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 512, "default": 26 },
        "columns": { "type": "integer", "minimum": 1, "maximum": 512, "default": 40 },
        "grain_width": { "type": "number", "exclusiveMinimum": 0, "default": 0.64 },
        "grain_height": { "type": "number", "exclusiveMinimum": 0, "default": 1 },
        "overlap": { "type": "number", "minimum": 0, "exclusiveMaximum": 1, "default": 0.18 },
        "stagger": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
        "relief": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.65 },
        "phase": { "type": "number", "default": 0 },
        "samples": { "type": "integer", "minimum": 2, "maximum": 4096, "default": 48 }
      }
    },
    "medallion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "medallion" },
        "origin": { "$ref": "#/$defs/point" },
        "plate_index": { "type": "integer", "minimum": 0, "maximum": 7, "default": 0 },
        "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 8192 },
        "ring_plates": { "type": "integer", "minimum": 1, "maximum": 256, "default": 6 },
        "ring_spacing": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.028 },
        "ring_stroke_width_ratio": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.0045 },
        "inset_radius_fraction": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.76 },
        "inset_scene_index": { "type": "integer", "minimum": 0, "maximum": 1024, "default": 0 }
      }
    },
    "vignette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "vignette" },
        "origin": { "$ref": "#/$defs/point" },
        "plate_index": { "type": "integer", "minimum": 0, "maximum": 7, "default": 0 },
        "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 8192 },
        "feather": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.18 },
        "falloff": { "type": "number", "exclusiveMinimum": 0, "default": 1.6 },
        "inset": { "type": "number", "minimum": 0, "exclusiveMaximum": 1, "default": 0.035 },
        "inner_color": { "allOf": [{ "$ref": "#/$defs/color" }], "default": "#070912" },
        "outer_color": { "allOf": [{ "$ref": "#/$defs/color" }], "default": "#070912" },
        "inner_opacity": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.04 },
        "outer_opacity": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.82 },
        "steps": { "type": "integer", "minimum": 1, "maximum": 256, "default": 24 },
        "annular_steps": { "type": "boolean", "default": true }
      }
    },
    "multicolor_line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "multicolor_line" },
        "origin": { "$ref": "#/$defs/point" },
        "plate_index": { "type": "integer", "minimum": 0, "maximum": 7, "default": 0 },
        "span": { "type": "number", "exclusiveMinimum": 0, "maximum": 16384 },
        "line_count": { "type": "integer", "minimum": 1, "maximum": 20000, "default": 17 },
        "spacing_fraction": { "type": "number", "minimum": 0, "default": 0.006 },
        "curvature_fraction": { "type": "number", "default": 0.12 },
        "curvature_cycles": { "type": "number", "exclusiveMinimum": 0, "default": 0.5 },
        "ramp": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "default": ["#2DE2E6", "#9D7BFF", "#FF3CAC", "#FFB000"],
          "items": { "$ref": "#/$defs/color" }
        },
        "interpolation": { "enum": ["discrete", "linear", "smoothstep"], "default": "smoothstep" },
        "blend": { "enum": ["normal", "multiply", "screen"], "default": "screen" },
        "apply_blend": { "type": "boolean", "default": true },
        "samples": { "type": "integer", "minimum": 2, "maximum": 16384, "default": 160 }
      }
    },
    "flinque": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "flinque" },
        "origin": { "$ref": "#/$defs/point" },
        "plate_index": { "type": "integer", "minimum": 0, "maximum": 7, "default": 0 },
        "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 8192 },
        "tint": { "allOf": [{ "$ref": "#/$defs/color" }], "default": "#2DE2E6" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.18 },
        "overlay_radius": { "type": "number", "exclusiveMinimum": 0, "default": 0.86 },
        "rays": { "type": "integer", "minimum": 1, "maximum": 20000, "default": 96 },
        "ray_tiers": { "type": "integer", "minimum": 1, "maximum": 256, "default": 2 },
        "phase": { "type": "number", "default": 0 },
        "tier_scale_step": { "type": "number", "default": 0.035 },
        "samples": { "type": "integer", "minimum": 2, "maximum": 4096, "default": 2 }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["colors"],
      "properties": {
        "colors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/color" }
        },
        "stroke_width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 32
        },
        "opacity": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1
        },
        "blend": { "enum": ["normal", "multiply", "screen"] }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_paths", "maximum_points", "maximum_svg_bytes"],
      "properties": {
        "maximum_paths": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "maximum_points": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000000
        },
        "maximum_svg_bytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 67108864
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "human_acceptance"],
      "properties": {
        "profile": {
          "enum": ["accessible-static", "motion-safe", "experimental"]
        },
        "human_acceptance": { "const": "PENDING" }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]*:[A-Za-z0-9_.-]+$"
      },
      "additionalProperties": true
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "family"],
      "properties": {
        "class": {
          "enum": ["radial", "banded", "lattice", "framed", "overlay"]
        },
        "family": {
          "enum": [
            "rosette",
            "sunburst",
            "band-guilloche",
            "medallion",
            "vignette",
            "multicolor-line",
            "flinque",
            "fish-scale",
            "barleycorn",
            "latent-image",
            "dutch-radiate",
            "dutch-stack",
            "dutch-quad",
            "dutch-hexagon",
            "dutch-mandala",
            "dutch-triptych"
          ]
        }
      }
    }
  }
}
