{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://izzi.dev/schema/izzi-wild-motion-episodes-1.json",
  "title": "Izzi wild-motion episode package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "status",
    "output_root",
    "profile",
    "authority",
    "episodes"
  ],
  "properties": {
    "schema_version": {
      "const": "izzi-wild-motion-episodes-1"
    },
    "package_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "status": {
      "enum": [
        "STAGE-0-PROVISIONAL",
        "REFINEMENT-CANDIDATE",
        "HUMAN-APPROVED"
      ]
    },
    "output_root": {
      "$ref": "#/$defs/repositoryPath"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "fps",
        "codec",
        "pixel_format",
        "audio",
        "text_policy"
      ],
      "properties": {
        "width": {
          "const": 1080
        },
        "height": {
          "const": 1920
        },
        "fps": {
          "const": 30
        },
        "codec": {
          "const": "h264"
        },
        "pixel_format": {
          "const": "yuv420p"
        },
        "audio": {
          "const": "NONE"
        },
        "text_policy": {
          "const": "TEXT-FREE-BY-DEFAULT"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_generation_authorized",
        "human_visual_acceptance",
        "baseline_promotion_authorized",
        "publication_authorized",
        "external_transfer_authorized"
      ],
      "properties": {
        "local_generation_authorized": {
          "const": true
        },
        "human_visual_acceptance": {
          "enum": ["PENDING", "APPROVED", "REJECTED"]
        },
        "baseline_promotion_authorized": {
          "type": "boolean"
        },
        "publication_authorized": {
          "type": "boolean"
        },
        "external_transfer_authorized": {
          "type": "boolean"
        }
      }
    },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/episode"
      }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "family"],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "family": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
        }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "speed", "transform", "palette", "mode", "opacity"],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "speed": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 4.0
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "palette": {
          "$ref": "#/$defs/palette"
        },
        "mode": {
          "enum": ["addition", "difference", "multiply", "screen"]
        },
        "opacity": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "maximum": 0.5
        }
      }
    },
    "transform": {
      "enum": ["identity", "hflip", "vflip", "rotate180"]
    },
    "palette": {
      "enum": ["identity", "mono", "warm", "cool", "invert"]
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "duration_seconds",
        "primary",
        "speed",
        "transform",
        "palette",
        "overlay"
      ],
      "properties": {
        "segment_id": {
          "type": "string",
          "pattern": "^segment-[0-9]{3}$"
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 2.0,
          "maximum": 30.0
        },
        "primary": {
          "$ref": "#/$defs/source"
        },
        "speed": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 4.0
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "palette": {
          "$ref": "#/$defs/palette"
        },
        "overlay": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/overlay"
            }
          ]
        }
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "episode_index",
        "duration_seconds",
        "review_status",
        "segments"
      ],
      "properties": {
        "episode_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
        },
        "episode_index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 60.0,
          "maximum": 180.0
        },
        "review_status": {
          "enum": ["STAGE-0-PROVISIONAL", "PENDING", "APPROVED", "REJECTED"]
        },
        "segments": {
          "type": "array",
          "minItems": 2,
          "maxItems": 90,
          "items": {
            "$ref": "#/$defs/segment"
          }
        }
      }
    }
  }
}
