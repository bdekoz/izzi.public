{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://izzi.example/schemas/izzi.guilloche-scene-1.schema.json",
  "title": "Izzi guilloche scene authoring document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scene_id",
    "canvas",
    "content",
    "treatment",
    "layout",
    "review"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "izzi.guilloche-scene/1"
    },
    "scene_id": {
      "$ref": "#/$defs/id"
    },
    "canvas": {
      "$ref": "#/$defs/canvas"
    },
    "content": {
      "$ref": "#/$defs/content"
    },
    "treatment": {
      "$ref": "#/$defs/treatment"
    },
    "layout": {
      "$ref": "#/$defs/radial_layout"
    },
    "palette": {
      "$ref": "#/$defs/palette"
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    },
    "pattern": {
      "$ref": "#/$defs/pattern"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "background"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 64,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 64,
          "maximum": 16384
        },
        "background": {
          "$ref": "#/$defs/color"
        },
        "transparent": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "number_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "number",
        "accessible_label"
      ],
      "properties": {
        "kind": {
          "const": "number"
        },
        "number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9][0-9 .,+-]*$"
        },
        "accessible_label": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "word_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "word",
        "accessible_label"
      ],
      "properties": {
        "kind": {
          "const": "word"
        },
        "word": {
          "$ref": "#/$defs/text"
        },
        "accessible_label": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "word_number_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "word",
        "number",
        "accessible_label"
      ],
      "properties": {
        "kind": {
          "const": "word-number"
        },
        "word": {
          "$ref": "#/$defs/text"
        },
        "number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9][0-9 .,+-]*$"
        },
        "accessible_label": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "content": {
      "oneOf": [
        {
          "$ref": "#/$defs/no_content"
        },
        {
          "$ref": "#/$defs/number_content"
        },
        {
          "$ref": "#/$defs/word_content"
        },
        {
          "$ref": "#/$defs/word_number_content"
        }
      ]
    },
    "bounded_pair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      ],
      "items": false
    },
    "treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "seed",
        "floral_group_range",
        "petal_range",
        "cycloid_amplitude",
        "density"
      ],
      "properties": {
        "kind": {
          "enum": [
            "cycloid-outline",
            "floral-cells",
            "floral-cycloid"
          ]
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "floral_group_range": {
          "$ref": "#/$defs/bounded_pair"
        },
        "petal_range": {
          "$ref": "#/$defs/bounded_pair"
        },
        "cycloid_amplitude": {
          "type": "number",
          "minimum": 0,
          "maximum": 256
        },
        "density": {
          "enum": [
            "accessible",
            "standard",
            "experimental",
            "wild"
          ]
        }
      }
    },
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 16384
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 16384
        }
      ],
      "items": false
    },
    "no_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "accessible_label"
      ],
      "properties": {
        "kind": {
          "const": "none"
        },
        "accessible_label": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "radial_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "symmetry_order",
        "center",
        "radius"
      ],
      "properties": {
        "kind": {
          "const": "radial"
        },
        "symmetry_order": {
          "type": "integer",
          "minimum": 2,
          "maximum": 24
        },
        "center": {
          "$ref": "#/$defs/point"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 8192
        },
        "geometries": {
          "$ref": "#/$defs/geometries"
        },
        "include_radial_field": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "harmonic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "multiple",
        "gain"
      ],
      "properties": {
        "multiple": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "gain": {
          "type": "number",
          "minimum": -8,
          "maximum": 8
        }
      }
    },
    "geometries": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/lobed_contour"
          },
          {
            "$ref": "#/$defs/basketweave_field"
          },
          {
            "$ref": "#/$defs/hobnail_field"
          },
          {
            "$ref": "#/$defs/directed_wave"
          },
          {
            "$ref": "#/$defs/sunburst"
          },
          {
            "$ref": "#/$defs/band_guilloche"
          },
          {
            "$ref": "#/$defs/latent_image"
          },
          {
            "$ref": "#/$defs/fish_scale_field"
          },
          {
            "$ref": "#/$defs/barleycorn_field"
          },
          {
            "$ref": "#/$defs/medallion"
          },
          {
            "$ref": "#/$defs/vignette"
          },
          {
            "$ref": "#/$defs/multicolor_line"
          },
          {
            "$ref": "#/$defs/flinque"
          },
          {
            "$ref": "#/$defs/organic_field"
          },
          {
            "$ref": "#/$defs/arabesque_field"
          },
          {
            "$ref": "#/$defs/water_field"
          },
          {
            "$ref": "#/$defs/optical_field"
          },
          {
            "$ref": "#/$defs/elliptic_loop"
          },
          {
            "$ref": "#/$defs/contour_loop"
          }
        ]
      }
    },
    "contour_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frequency",
        "amplitude"
      ],
      "properties": {
        "frequency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "amplitude": {
          "type": "number",
          "minimum": -0.45,
          "maximum": 0.45
        },
        "phase": {
          "type": "number"
        }
      }
    },
    "lobed_contour": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "lobed_contour"
        },
        "origin": {
          "$ref": "#/$defs/point"
        },
        "plate_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 8192
        },
        "modes": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/contour_mode"
          }
        },
        "rotation": {
          "type": "number"
        },
        "samples": {
          "type": "integer",
          "minimum": 16,
          "maximum": 16384
        },
        "rings": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "ring_spacing": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "deformation": {
          "$ref": "#/$defs/deformation"
        }
      }
    },
    "basketweave_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "basketweave_field"
        },
        "origin": {
          "$ref": "#/$defs/point"
        },
        "plate_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "pitch": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 8192
        },
        "rotation": {
          "type": "number"
        },
        "samples": {
          "type": "integer",
          "minimum": 2,
          "maximum": 256
        },
        "band_width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width_ratios": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "strands": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "clearance": {
          "type": "number",
          "minimum": 0
        },
        "parity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "periodic": {
          "type": "boolean"
        },
        "deformation": {
          "$ref": "#/$defs/deformation"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "periodic": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "rows": {
                "multipleOf": 2
              },
              "columns": {
                "multipleOf": 2
              }
            }
          }
        }
      ]
    },
    "hobnail_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "hobnail_field"
        },
        "origin": {
          "$ref": "#/$defs/point"
        },
        "plate_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "pitch": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 8192
        },
        "rotation": {
          "type": "number"
        },
        "samples": {
          "type": "integer",
          "minimum": 2,
          "maximum": 256
        },
        "contours": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "deformation": {
          "$ref": "#/$defs/deformation"
        }
      }
    },
    "directed_wave": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "directed_wave"
        },
        "origin": {
          "$ref": "#/$defs/point"
        },
        "plate_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "span": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 16384
        },
        "amplitude": {
          "type": "number",
          "minimum": 0,
          "maximum": 8192
        },
        "frequency": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1024
        },
        "phase": {
          "type": "number"
        },
        "envelope": {
          "type": "number",
          "minimum": -0.9,
          "maximum": 0.9
        },
        "chirp": {
          "type": "number",
          "minimum": -128,
          "maximum": 128
        },
        "samples": {
          "type": "integer",
          "minimum": 8,
          "maximum": 16384
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "spacing": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 8192
        },
        "deformation": {
          "$ref": "#/$defs/deformation"
        }
      }
    },
    "sunburst": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "sunburst"
        },
        "origin": {
          "$ref": "#/$defs/point"
        },
        "plate_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7,
          "default": 0
        },
        "outer_radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 8192
        },
        "rays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000,
          "default": 120
        },
        "ray_tiers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256,
          "default": 2
        },
        "inner_radius_fraction": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1,
          "default": 0.18
        },
        "phase": {
          "type": "number",
          "default": 0
        },
        "scale_step": {
          "type": "number",
          "default": 0.035
        },
        "samples": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4096,
          "default": 2
        },
        "deformation": {
          "$ref": "#/$defs/deformation"
        }
      }
    },
    "band_guilloche": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "band_guilloche"
        },
        "origin": {
          "$ref": "#/$defs/point"
        },
        "plate_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7,
          "default": 0
        },
        "span": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 16384
        },
        "amplitude": {
          "type": "number",
          "minimum": 0,
          "maximum": 8192
        },
        "fundamental_frequency": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1024,
          "default": 12
        },
        "harmonics": {
          "type": "array",
          "maxItems": 32,
          "default": [
            {
              "multiple": 2,
              "gain": 0.28
            },
            {
              "multiple": 3,
              "gain": 0.12
            }
          ],
          "items": {
            "$ref": "#/$defs/harmonic"
          }
        },
        "phase": {
          "type": "number",
          "default": 0
        },
        "line_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000,
          "default": 11
        },
        "phase_step": {
          "type": "number",
          "default": 0.16
        },
        "normal_offset_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 32,
          "default": 0.2
        },
        "envelope": {
          "type": "number",
          "minimum": -0.9,
          "maximum": 0.9
        },
        "chirp": {
          "type": "number",
          "minimum": -128,
          "maximum": 128
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000,
          "default": 5
        },
        "row_spacing": {
          "type": "number",
          "minimum": 0,
          "maximum": 16384,
          "default": 0
        },
        "samples": {
          "type": "integer",
          "minimum": 8,
          "maximum": 16384,
          "default": 384
        },
        "deformation": {
          "$ref": "#/$defs/deformation"
        }
      }
    },
    "latent_image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "latent_image"
        },
        "origin": {
          "$ref": "#/$defs/point"
        },
        "plate_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7,
          "default": 0
        },
        "span": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 16384
        },
        "line_spacing": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 1024,
          "default": 6
        },
        "cell_size": {
          "type": "number",
          "minimum": 1,
          "maximum": 8192,
          "default": 72
        },
        "primary_angle": {
          "type": "number",
          "minimum": -1.0471975511965976,
          "maximum": 1.0471975511965976,
          "default": -0.2
        },
        "secondary_angle": {
          "type": "number",
          "minimum": -1.0471975511965976,
          "maximum": 1.0471975511965976,
          "default": 0.2
        },
        "phase": {
          "type": "number",
          "minimum": -1.0471975511965976,
          "maximum": 1.0471975511965976,
          "default": 0
        },
        "samples": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4096,
          "default": 8
        },
        "deformation": {
          "$ref": "#/$defs/deformation"
        }
      }
    },
    "fish_scale_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "fish_scale_field"
        },
        "origin": {
          "$ref": "#/$defs/point"
        },
        "plate_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7,
          "default": 0
        },
        "cell_size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 8192
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512,
          "default": 36
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512,
          "default": 28
        },
        "scale_width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1
        },
        "scale_height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.72
        },
        "overlap": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1,
          "default": 0.44
        },
        "stagger": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        },
        "seam_depth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.12
        },
        "phase": {
          "type": "number",
          "default": 0
        },
        "samples": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4096,
          "default": 48
        },
        "deformation": {
          "$ref": "#/$defs/deformation"
        }
      }
    },
    "barleycorn_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "barleycorn_field"
        },
        "origin": {
          "$ref": "#/$defs/point"
        },
        "plate_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7,
          "default": 0
        },
        "cell_size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 8192
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512,
          "default": 26
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512,
          "default": 40
        },
        "grain_width": {
          "type": "number",
          "exclusiveMinimum": 0,
