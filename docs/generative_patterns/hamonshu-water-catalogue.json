    {
      "id": "foam",
      "name": "Foam, spray, droplets and cells",
      "description": "Detached water marks, dotted spray, bead chains, bubbly rims and cellular water textures.",
      "construction": "Sparse secondary marks following a parent crest; bounded point and small-loop motifs.",
