          0.51
        ]
      }
    },
    {
      "id": "arc",
      "name": "Ripples, scallops and nested arcs",
      "description": "Repeated arc bundles, ripple rings, scales and small rounded swells.",
      "construction": "Nested arcs and partial rings; staggered repeats with explicit open and closed forms.",
      "representative": {
        "volume": 3,
