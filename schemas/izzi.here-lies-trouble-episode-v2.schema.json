{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://izzi.dev/schemas/izzi.here-lies-trouble-episode-v2.schema.json",
  "title": "Here Lies Trouble episode motion and audio review contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "episode_index",
    "scene_id",
    "status",
    "identity",
    "supersedes",
    "sources",
    "form",
    "title_card",
    "cast",
    "location",
    "conversation",
    "audio_mix",
    "motion",
    "provider_gate",
    "review_gates",
    "output",
    "authority"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "izzi.here-lies-trouble-episode-v2/1"
    },
    "project_id": {
      "const": "here-lies-trouble"
    },
    "episode_index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 90
    },
    "scene_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "status": {
      "enum": [
        "AWAITING-HUMAN-CONFIRMATION",
        "APPROVED-FOR-LOCAL-CANARIES",
        "CANARIES-READY-FOR-HUMAN-REVIEW",
        "APPROVED-FOR-FULL-LOCAL-ASSEMBLY",
        "FULL-EPISODE-READY-FOR-HUMAN-REVIEW",
        "REVISE",
        "ACCEPTED"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location_slug", "artifact_version", "canonical_basename"],
      "properties": {
        "location_slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "artifact_version": {
          "type": "string",
          "pattern": "^v[1-9][0-9]*$"
        },
        "canonical_basename": {
          "type": "string",
          "pattern": "^here-lies-trouble-episode-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*\\.v[1-9][0-9]*\\.mkv$"
        }
      }
    },
    "supersedes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "human_disposition", "requested_v1_basename"],
      "properties": {
        "path": { "$ref": "#/$defs/repository_path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "human_disposition": { "const": "REVISE" },
        "requested_v1_basename": {
          "const": "here-lies-trouble-episode-01-frogtown.v1.mkv"
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted_visual", "transformed_dialogue", "ambience"],
      "properties": {
        "accepted_visual": { "$ref": "#/$defs/hashed_source" },
        "transformed_dialogue": {
          "allOf": [
            { "$ref": "#/$defs/hashed_source" },
            {
              "type": "object",
              "required": ["manifest_path", "manifest_sha256", "speaker_diarization"],
              "properties": {
                "manifest_path": { "$ref": "#/$defs/repository_path" },
                "manifest_sha256": { "$ref": "#/$defs/sha256" },
                "speaker_diarization": { "const": "NOT-PERFORMED" }
              }
            }
          ]
        },
        "ambience": {
          "allOf": [
            { "$ref": "#/$defs/hashed_source" },
            {
              "type": "object",
              "required": ["provenance_status", "decode_once_before_mix"],
              "properties": {
                "provenance_status": {
                  "enum": ["USER-SUPPLIED-RESOURCE", "USER-CONFIRMED-RESOURCE"]
                },
                "decode_once_before_mix": { "const": true }
              }
            }
          ]
        }
      }
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title_seconds",
        "content_seconds",
        "total_seconds",
        "width",
        "height",
        "fps",
        "pixel_format"
      ],
      "properties": {
        "title_seconds": { "const": 3 },
        "content_seconds": { "const": 165 },
        "total_seconds": { "const": 168 },
        "width": { "const": 720 },
        "height": { "const": 1280 },
        "fps": { "const": 30 },
        "pixel_format": { "const": "yuv420p" }
      }
    },
    "title_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible_text", "background", "foreground", "typography"],
      "properties": {
        "visible_text": { "const": "1" },
        "background": { "const": "#000000" },
        "foreground": { "const": "#ffffff" },
        "typography": { "const": "devastation-pacific-house-style-2.3" }
      }
    },
    "cast": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/cast_member" }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "slug", "route_beats", "required_anchors", "reference_images"],
      "properties": {
        "display_name": { "type": "string", "minLength": 1 },
        "slug": { "const": "frogtown" },
        "route_beats": {
          "type": "array",
          "minItems": 3,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/route_beat" }
        },
        "required_anchors": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "reference_images": {
          "type": "array",
          "items": { "$ref": "#/$defs/optional_hashed_source" }
        }
      }
    },
    "conversation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synchronization_mode",
        "exact_lip_sync_required",
        "active_speaker_gesture",
        "listener_reactions",
        "walk_while_talking"
      ],
      "properties": {
        "synchronization_mode": {
          "enum": ["TURN-AWARE-GESTURE", "APPROXIMATE-MOUTH", "NO-DIALOGUE-SYNCHRONIZATION"]
        },
        "exact_lip_sync_required": { "type": "boolean" },
        "active_speaker_gesture": { "type": "boolean" },
        "listener_reactions": { "type": "boolean" },
        "walk_while_talking": { "type": "boolean" }
      }
    },
    "audio_mix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canary", "production", "ambience", "delivery"],
      "properties": {
        "canary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["normalization_scope", "label", "target_lufs_i", "true_peak_dbfs"],
          "properties": {
            "normalization_scope": { "const": "ENGINEERING-WINDOWS-NOT-SPEAKERS" },
            "label": { "const": "PROVISIONAL-WINDOW-NORMALIZED-REVIEW-MIX" },
            "target_lufs_i": { "type": "number", "minimum": -24, "maximum": -14 },
            "true_peak_dbfs": { "type": "number", "minimum": -3, "maximum": -1 }
          }
        },
        "production": {
          "type": "object",
          "additionalProperties": false,
          "required": ["corrected_diarization_required", "stable_speaker_ids_required", "per_speaker_normalization_required"],
          "properties": {
            "corrected_diarization_required": { "const": true },
            "stable_speaker_ids_required": { "const": true },
            "per_speaker_normalization_required": { "const": true }
          }
        },
        "ambience": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_offset_seconds", "loop_if_needed", "target_lufs_i", "duck_under_dialogue_db"],
          "properties": {
            "source_offset_seconds": { "type": "number", "minimum": 0 },
            "loop_if_needed": { "type": "boolean" },
            "target_lufs_i": { "type": "number", "minimum": -45, "maximum": -22 },
            "duck_under_dialogue_db": { "type": "number", "minimum": 0, "maximum": 12 }
          }
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sample_rate", "channels", "channel_layout", "target_lufs_i", "true_peak_dbfs", "lra_max_lu"],
          "properties": {
            "sample_rate": { "const": 48000 },
            "channels": { "const": 2 },
            "channel_layout": { "const": "stereo" },
            "target_lufs_i": { "type": "number", "minimum": -24, "maximum": -14 },
            "true_peak_dbfs": { "type": "number", "minimum": -3, "maximum": -1 },
            "lra_max_lu": { "type": "number", "minimum": 4, "maximum": 18 }
          }
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canaries", "episode_structure", "invariants", "maximum_static_hold_seconds"],
      "properties": {
        "canaries": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/motion_canary" }
        },
        "episode_structure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["narrative_beats", "shot_duration_seconds", "animatic_before_motion_batch"],
          "properties": {
            "narrative_beats": { "type": "integer", "minimum": 5, "maximum": 16 },
            "shot_duration_seconds": {
              "type": "array",
              "prefixItems": [
                { "type": "number", "minimum": 2, "maximum": 12 },
                { "type": "number", "minimum": 3, "maximum": 15 }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "animatic_before_motion_batch": { "const": true }
          }
        },
        "invariants": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "maximum_static_hold_seconds": { "type": "number", "minimum": 0, "maximum": 5 }
      }
    },
    "provider_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "external_submission_authorized", "cost_ceiling", "quality_request"],
      "properties": {
        "provider": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "external_submission_authorized": { "type": "boolean" },
        "cost_ceiling": { "type": ["number", "null"], "minimum": 0 },
        "quality_request": { "enum": ["720p-preview", "1080p-production"] }
      }
    },
    "review_gates": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/review_gate" }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "audio_canary", "ambience_intermediate", "audio_review_mkv", "audio_probe", "audio_manifest", "motion_canary_root", "animatic", "review_master", "filmstrip", "manifest"],
      "properties": {
        "root": { "$ref": "#/$defs/repository_path" },
        "audio_canary": { "$ref": "#/$defs/repository_path" },
        "ambience_intermediate": { "$ref": "#/$defs/repository_path" },
        "audio_review_mkv": { "$ref": "#/$defs/repository_path" },
        "audio_probe": { "$ref": "#/$defs/repository_path" },
        "audio_manifest": { "$ref": "#/$defs/repository_path" },
        "motion_canary_root": { "$ref": "#/$defs/repository_path" },
        "animatic": { "$ref": "#/$defs/repository_path" },
        "review_master": { "$ref": "#/$defs/repository_path" },
        "filmstrip": { "$ref": "#/$defs/repository_path" },
        "manifest": { "$ref": "#/$defs/repository_path" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planning_authorized",
        "local_generation_authorized",
        "provider_submission_authorized",
        "additional_spending_authorized",
        "audio_transfer_authorized",
        "publication_authorized",
        "baseline_promotion_authorized",
        "training_conversion_transfer_authorized",
        "wait_for_user_confirmation"
      ],
      "properties": {
        "planning_authorized": { "const": true },
        "local_generation_authorized": { "type": "boolean" },
        "provider_submission_authorized": { "type": "boolean" },
        "additional_spending_authorized": { "type": "boolean" },
        "audio_transfer_authorized": { "type": "boolean" },
        "publication_authorized": { "type": "boolean" },
        "baseline_promotion_authorized": { "type": "boolean" },
        "training_conversion_transfer_authorized": { "const": false },
        "wait_for_user_confirmation": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "hashed_source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/repository_path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "optional_hashed_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "decision_status"],
      "properties": {
        "path": { "$ref": "#/$defs/repository_path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "decision_status": { "enum": ["PROPOSED", "USER-ACCEPTED", "REJECTED"] }
      }
    },
    "cast_member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["animal", "stable_visual_markers", "motion_personality", "provisional_speaker_code", "decision_status"],
      "properties": {
        "animal": { "enum": ["unicorn", "albatross", "dog", "cat"] },
        "stable_visual_markers": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "motion_personality": { "type": "string", "minLength": 1 },
        "provisional_speaker_code": { "type": ["string", "null"] },
        "decision_status": { "enum": ["PROPOSED", "NEEDS-HUMAN", "USER-ACCEPTED"] }
      }
    },
    "route_beat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beat_id", "place", "group_action", "conversation_action", "decision_status"],
      "properties": {
        "beat_id": { "type": "string", "pattern": "^beat-[0-9]{2}$" },
        "place": { "type": "string", "minLength": 1 },
        "group_action": { "type": "string", "minLength": 1 },
        "conversation_action": { "type": "string", "minLength": 1 },
        "decision_status": { "enum": ["PROPOSED", "NEEDS-HUMAN", "USER-ACCEPTED"] }
      }
    },
    "motion_canary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canary_id", "duration_seconds", "purpose", "required_actions", "status"],
      "properties": {
        "canary_id": { "type": "string", "pattern": "^motion-canary-[0-9]{2}$" },
        "duration_seconds": { "type": "number", "minimum": 5, "maximum": 10 },
        "purpose": { "type": "string", "minLength": 1 },
        "required_actions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "status": { "enum": ["PLANNED", "GENERATED", "USER-ACCEPTED", "REVISE", "REJECTED"] }
      }
    },
    "review_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "artifact_class", "status", "acceptance_conditions"],
      "properties": {
        "gate_id": { "type": "string", "pattern": "^gate-[0-9]{2}$" },
        "artifact_class": {
          "enum": ["AUDIO-CANARY", "MOTION-CANARIES", "FULL-EPISODE-ANIMATIC", "FULL-EPISODE-REVIEW-MASTER"]
        },
        "status": { "enum": ["NOT-STARTED", "READY-FOR-HUMAN", "USER-ACCEPTED", "REVISE", "REJECTED"] },
        "acceptance_conditions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
