          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "contour_loop"
        },
        "origin": {
          "$ref": "#/$defs/point"
        },
        "plate_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "normal_amplitude": {
          "type": "number",
          "minimum": 0,
          "maximum": 2048
        },
        "tangent_amplitude": {
          "type": "number",
          "minimum": -2048,
          "maximum": 2048
        },
        "cycles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "phase": {
          "type": "number"
        },
        "secondary": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 0.5
        },
        "samples": {
          "type": "integer",
          "minimum": 32,
          "maximum": 32768
        },
        "strands": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "phase_step": {
          "type": "number"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 8192
        },
        "x_scale": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 8
        },
        "y_scale": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 8
        },
        "rotation": {
          "type": "number"
        },
        "modes": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/contour_mode"
          }
        },
        "phase_modulation": {
          "type": "number",
          "minimum": -16,
          "maximum": 16
        },
        "phase_frequency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "$comment": "Native validation also requires sum(abs(mode amplitudes)) <= .45, radius*max(x_scale,y_scale) <= 8192, and samples >= 32*(max(1, mode frequencies) + (cycles+ceil(abs(phase_modulation)*phase_frequency))*(secondary != 0 ? 2 : 1))."
    }
  }
}
