{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://izzi.dev/schemas/izzi.here-lies-trouble-motion-canary.schema.json",
  "title": "Here Lies Trouble silent motion canary specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "canary_id",
    "project_id",
    "episode_index",
    "location_slug",
    "artifact_version",
    "status",
    "sources",
    "profile",
    "cast",
    "motion_test",
    "scene",
    "continuity_invariants",
    "prompt",
    "negative_prompt",
    "review_questions",
    "provider_adapter",
    "intended_output",
    "authority"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": {
      "const": "izzi.here-lies-trouble-motion-canary/1"
    },
    "canary_id": {
      "type": "string",
      "pattern": "^hlt-frogtown-v2-motion-canary-0[1-3]$"
    },
    "project_id": { "const": "here-lies-trouble" },
    "episode_index": { "const": 1 },
    "location_slug": { "const": "frogtown" },
    "artifact_version": { "const": "v2" },
    "status": {
      "enum": [
        "SPECIFICATION-READY-HUMAN-REVIEW-PENDING",
        "SPECIFICATION-AUTHORIZED-PENDING-SUBMISSION",
        "TECHNICALLY-VERIFIED-HUMAN-REVIEW-PENDING"
      ]
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_config", "accepted_visual"],
      "properties": {
        "episode_config": { "$ref": "#/$defs/hashed_source" },
        "accepted_visual": { "$ref": "#/$defs/hashed_source" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "duration_seconds", "audio", "generated_text"],
      "properties": {
        "width": { "const": 720 },
        "height": { "const": 1280 },
        "duration_seconds": { "const": 5 },
        "audio": { "const": false },
        "generated_text": { "const": false }
      }
    },
    "cast": {
      "type": "array",
      "prefixItems": [
        { "const": "unicorn" },
        { "const": "albatross" },
        { "const": "dog" },
        { "const": "cat" }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "motion_test": {
      "enum": [
        "GROUP-WALK",
        "CONVERSATION-AND-LISTENER-REACTIONS",
        "LOCATION-EXPLORATION"
      ]
    },
    "motion_aesthetic_seeds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/motion_aesthetic_seed_reference" }
    },
    "motion_grammar": { "$ref": "#/$defs/motion_grammar" },
    "cost_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimated_credits_per_job",
        "maximum_credits_per_job",
        "maximum_total_credits"
      ],
      "properties": {
        "estimated_credits_per_job": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "maximum_credits_per_job": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "maximum_total_credits": {
          "type": "integer",
          "exclusiveMinimum": 0
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frogtown_anchor",
        "starting_composition",
        "required_action",
        "ending_composition",
        "camera",
        "environmental_motion"
      ],
      "properties": {
        "frogtown_anchor": { "type": "string", "minLength": 1 },
        "starting_composition": { "type": "string", "minLength": 1 },
        "required_action": { "type": "string", "minLength": 1 },
        "ending_composition": { "type": "string", "minLength": 1 },
        "camera": { "type": "string", "minLength": 1 },
        "environmental_motion": { "type": "string", "minLength": 1 }
      }
    },
    "continuity_invariants": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "prompt": { "type": "string", "minLength": 200 },
    "negative_prompt": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "review_questions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1 }
    },
    "provider_adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "seed", "requested_quality", "submission_status"],
      "properties": {
        "provider": {
          "anyOf": [
            { "type": "null" },
            { "const": "seedance2ai.io" }
          ]
        },
        "model": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1 }
          ]
        },
        "seed": {
          "anyOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1 }
          ]
        },
        "requested_quality": { "const": "720p-preview" },
        "submission_status": {
          "enum": ["NOT-AUTHORIZED", "AUTHORIZED", "SUBMITTED", "COMPLETED"]
        }
      }
    },
    "intended_output": {
      "type": "string",
      "pattern": "^outputs/review/feedback/visual/here-lies-trouble/neon-addict-stage-01/episode-01-local-trial/motion-canaries/v2/here-lies-trouble-episode-01-frogtown\\.v2\\.motion-canary-0[1-3]\\.mkv$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_specification_authorized",
        "motion_generation_authorized",
        "provider_submission_authorized",
        "additional_spending_authorized",
        "audio_transfer_authorized",
        "publication_authorized",
        "baseline_promotion_authorized",
        "training_conversion_transfer_authorized"
      ],
      "properties": {
        "local_specification_authorized": { "const": true },
        "motion_generation_authorized": { "type": "boolean" },
        "provider_submission_authorized": { "type": "boolean" },
        "additional_spending_authorized": { "type": "boolean" },
        "audio_transfer_authorized": { "const": false },
        "publication_authorized": { "type": "boolean" },
        "baseline_promotion_authorized": { "const": false },
        "training_conversion_transfer_authorized": { "const": false }
      }
    }
  },
  "$defs": {
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hashed_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/repository_path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "motion_aesthetic_seed_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed_id", "role"],
      "properties": {
        "seed_id": {
          "type": "string",
          "pattern": "^br-final-cut-cut-[1-5]$"
        },
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "motion_grammar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["camera", "subject_motion", "environmental_motion", "tempo"],
      "properties": {
        "camera": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "subject_motion": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "environmental_motion": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "tempo": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "motion_aesthetic_seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed_id", "source", "measured", "motion_grammar", "review"],
      "properties": {
        "seed_id": {
          "type": "string",
          "pattern": "^br-final-cut-cut-[1-5]$"
        },
        "source": { "$ref": "#/$defs/hashed_source" },
        "measured": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "duration_seconds",
            "fps",
            "frames",
            "coverage_mean_percent",
            "coverage_peak_percent",
            "motion_mean",
            "motion_peak",
            "luma_mean_255",
            "saturation_mid_percent",
            "single_take"
          ],
          "properties": {
            "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
            "fps": { "type": "number", "exclusiveMinimum": 0 },
            "frames": { "type": "integer", "minimum": 1 },
            "coverage_mean_percent": { "type": "number" },
            "coverage_peak_percent": { "type": "number" },
            "motion_mean": { "type": "number" },
            "motion_peak": { "type": "number" },
            "luma_mean_255": {
              "type": "number",
              "minimum": 0,
              "maximum": 255
            },
            "saturation_mid_percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "single_take": { "type": "boolean" }
          }
        },
        "motion_grammar": { "$ref": "#/$defs/motion_grammar" },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["PENDING", "APPROVED"] }
          }
        }
      }
    }
  }
}
